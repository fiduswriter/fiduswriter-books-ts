{
    "name": "@fiduswriter/books-document",
    "version": "0.1.29",
    "description": "Fidus Writer book importers and exporters",
    "keywords": [
        "fiduswriter",
        "books",
        "document",
        "epub",
        "docx",
        "odt",
        "latex",
        "html",
        "bits",
        "export",
        "import"
    ],
    "homepage": "https://git.fiduswriter.org/fiduswriter/fiduswriter-books-ts",
    "bugs": {
        "url": "https://git.fiduswriter.org/fiduswriter/fiduswriter-books-ts/issues"
    },
    "repository": {
        "type": "git",
        "url": "https://git.fiduswriter.org/fiduswriter/fiduswriter-books-ts.git"
    },
    "license": "AGPL-3.0",
    "author": "Johannes Wilm",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./schema": {
            "types": "./dist/schema/index.d.ts",
            "default": "./dist/schema/index.js"
        },
        "./importer/native": {
            "types": "./dist/importer/native/index.d.ts",
            "default": "./dist/importer/native/index.js"
        },
        "./exporter/native": {
            "types": "./dist/exporter/native/index.d.ts",
            "default": "./dist/exporter/native/index.js"
        },
        "./exporter/html": {
            "types": "./dist/exporter/html/index.d.ts",
            "default": "./dist/exporter/html/index.js"
        },
        "./exporter/epub": {
            "types": "./dist/exporter/epub/index.d.ts",
            "default": "./dist/exporter/epub/index.js"
        },
        "./exporter/latex": {
            "types": "./dist/exporter/latex/index.d.ts",
            "default": "./dist/exporter/latex/index.js"
        },
        "./exporter/docx": {
            "types": "./dist/exporter/docx/index.d.ts",
            "default": "./dist/exporter/docx/index.js"
        },
        "./exporter/odt": {
            "types": "./dist/exporter/odt/index.d.ts",
            "default": "./dist/exporter/odt/index.js"
        },
        "./exporter/print": {
            "types": "./dist/exporter/print/index.d.ts",
            "default": "./dist/exporter/print/index.js"
        },
        "./exporter/bits": {
            "types": "./dist/exporter/bits/index.d.ts",
            "default": "./dist/exporter/bits/index.js"
        },
        "./exporter/tools": {
            "types": "./dist/exporter/tools.d.ts",
            "default": "./dist/exporter/tools.js"
        },
        "./i18n": {
            "types": "./dist/i18n.d.ts",
            "default": "./dist/i18n.js"
        },
        "./ui/book_dialog": {
            "types": "./dist/ui/book_dialog/index.d.ts",
            "default": "./dist/ui/book_dialog/index.js"
        }
    },
    "directories": {
        "test": "test"
    },
    "files": [
        "dist/",
        "css/",
        "src/",
        "README.md",
        "LICENSE",
        "logo.svg",
        "locale/*/messages.json"
    ],
    "scripts": {
        "build": "tsc",
        "prepare": "husky",
        "prepublishOnly": "npm run build",
        "typecheck": "tsc --noEmit",
        "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.js",
        "lint": "eslint src test",
        "lint:fix": "eslint src test --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "install-hooks": "husky",
        "compile-i18n": "node scripts/compile-i18n.js",
        "extract-i18n": "node scripts/extract-i18n.js"
    },
    "dependencies": {
        "@fiduswriter/document": "^0.3.28",
        "bibliojson": "^4.1.0",
        "downloadjs": "^1.4.7",
        "fast-deep-equal": "^3.1.3",
        "fwtoolkit": "^0.2.26",
        "js-beautify": "^2.0.3",
        "jszip": "^3.10.2"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@swc/core": "^1.16.13",
        "@swc/jest": "^0.2.39",
        "@types/node": "^26.6.4",
        "@typescript/native": "npm:typescript@^7.0.2",
        "eslint": "^10.12.0",
        "gettext-parser": "^9.1.1",
        "globals": "^17.13.0",
        "husky": "^9.1.7",
        "jest": "^30.5.2",
        "lint-staged": "^17.6.0",
        "prettier": "^3.9.9",
        "prosemirror-model": "^1.25.12",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "typescript-eslint": "^8.71.0"
    },
    "lint-staged": {
        "*.{ts,js,mjs,css,md,json,html}": [
            "prettier --write"
        ],
        "*.{ts,js,mjs}": [
            "eslint --fix",
            "sh -c 'npm run typecheck'"
        ]
    }
}
